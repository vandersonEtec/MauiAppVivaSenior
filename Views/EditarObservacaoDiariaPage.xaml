<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.EditarObservacaoDiariaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="12">

            <Label
                Text="Editar Observação Diária"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Label
                x:Name="lblNomeIdoso"
                FontFamily="OpenSansRegular"
                FontSize="15"
                TextColor="#666666" />

            <Label
                Text="Data"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="#155263" />

            <DatePicker
                x:Name="dtpData"
                Format="dd/MM/yyyy" />

            <Label
                Text="Alimentação"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="#155263" />

            <Editor
                x:Name="txtAlimentacao"
                Placeholder="Informe como foi a alimentação"
                AutoSize="TextChanges"
                MinimumHeightRequest="80" />

            <Label
                Text="Hidratação"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="#155263" />

            <Editor
                x:Name="txtHidratacao"
                Placeholder="Informe como foi a hidratação"
                AutoSize="TextChanges"
                MinimumHeightRequest="80" />

            <Label
                Text="Sono"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="#155263" />

            <Editor
                x:Name="txtSono"
                Placeholder="Informe como foi o sono"
                AutoSize="TextChanges"
                MinimumHeightRequest="80" />

            <Label
                Text="Medicação diária"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="#155263" />

            <Editor
                x:Name="txtMedicacaoDiaria"
                Placeholder="Informe sobre os medicamentos administrados"
                AutoSize="TextChanges"
                MinimumHeightRequest="80" />

            <Label
                Text="Observações"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                TextColor="#155263" />

            <Editor
                x:Name="txtObservacoes"
                Placeholder="Digite outras informações importantes"
                AutoSize="TextChanges"
                MinimumHeightRequest="100" />

            <HorizontalStackLayout
                Spacing="10"
                Margin="0,10,0,0">

                <Button
                    Text="Cancelar"
                    FontFamily="OpenSansSemibold"
                    BackgroundColor="#777777"
                    TextColor="White"
                    CornerRadius="9"
                    HeightRequest="46"
                    HorizontalOptions="FillAndExpand"
                    Clicked="BtnCancelar_Clicked" />

                <Button
                    Text="Salvar"
                    FontFamily="OpenSansSemibold"
                    BackgroundColor="#155263"
                    TextColor="White"
                    CornerRadius="9"
                    HeightRequest="46"
                    HorizontalOptions="FillAndExpand"
                    Clicked="BtnSalvar_Clicked" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>