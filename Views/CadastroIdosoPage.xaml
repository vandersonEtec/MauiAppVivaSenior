<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppVivaSenior.Views.CadastroIdosoPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Cadastro de Idoso"
                FontSize="24"
                FontAttributes="Bold" />

            <Entry
                x:Name="txtNome"
                Placeholder="Nome completo" />

            <DatePicker
                x:Name="dtpDataNascimento" />

            <Entry
                x:Name="txtCPF"
                Placeholder="CPF" />

            <Entry
                x:Name="txtTelefone"
                Placeholder="Telefone"
                Keyboard="Telephone" />

            <Entry
                x:Name="txtEndereco"
                Placeholder="Endereço" />

            <Editor
                x:Name="txtObservacoes"
                Placeholder="Observações"
                AutoSize="TextChanges"
                HeightRequest="100" />

            <Button
                Text="Salvar"
                Clicked="BtnSalvar_Clicked" />

            <Button
                Text="Cancelar"
                Clicked="BtnCancelar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>