<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.EditarMedicamentoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="9">

            <Label
                Text="Editar Medicação"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#155263"
                Margin="0,0,0,4" />

            <Border
                BackgroundColor="White"
                Stroke="#DCE7E5"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="14">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="Medicação"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblNomeMedicamento"
                        FontFamily="OpenSansSemibold"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#155263"
                        Margin="0,0,0,5" />

                    <Label
                        Text="Via de Administração"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Picker
                        x:Name="pckViaAdministracao"
                        Title="Selecione a via"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="60">

                        <Picker.Items>
                            <x:String>Oral</x:String>
                            <x:String>Injetável</x:String>
                            <x:String>Tópica</x:String>
                            <x:String>Ocular</x:String>
                            <x:String>Nasal</x:String>
                            <x:String>Inalatória</x:String>
                            <x:String>Outra</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Status"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Picker
                        x:Name="pckStatus"
                        Title="Selecione o status"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="60">

                        <Picker.Items>
                            <x:String>Ativo</x:String>
                            <x:String>Inativo</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Dosagem"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Entry
                        x:Name="txtDosagem"
                        Placeholder="Ex.: 50 mg"
                        PlaceholderColor="#888888"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42" />

                    <Label
                        Text="Horário"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Entry
                        x:Name="txtHorario"
                        Placeholder="Ex.: 08:00"
                        PlaceholderColor="#888888"
                        Keyboard="Numeric"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42" />

                    <Label
                        Text="Observação"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Editor
                        x:Name="txtObservacao"
                        Placeholder="Digite uma observação"
                        PlaceholderColor="#888888"
                        AutoSize="TextChanges"
                        HeightRequest="70"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="SALVAR ALTERAÇÕES"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                BackgroundColor="#155263"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="44"
                Margin="0,2,0,0"
                Clicked="BtnSalvar_Clicked" />

            <Button
                Text="CANCELAR"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                BackgroundColor="#777777"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="44"
                Clicked="BtnCancelar_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>