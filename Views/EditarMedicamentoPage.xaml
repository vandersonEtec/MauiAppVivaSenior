<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.EditarMedicamentoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Editar Medicação"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Editar Medicação"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Label
                x:Name="lblNomeMedicamento"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Label
                Text="Dosagem"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Entry
                x:Name="txtDosagem"
                Placeholder="Ex.: 50 mg" />

            <Label
                Text="Horário"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Entry
                x:Name="txtHorario"
                Placeholder="Ex.: 08:00" />

            <Label
                Text="Observação"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Editor
                x:Name="txtObservacao"
                Placeholder="Digite uma observação"
                AutoSize="TextChanges"
                HeightRequest="100" />

            <Button
                Text="Salvar"
                BackgroundColor="#10A77F"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="BtnSalvar_Clicked" />

            <Button
                Text="Cancelar"
                BackgroundColor="#777777"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="BtnCancelar_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>