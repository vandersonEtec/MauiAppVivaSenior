<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppVivaSenior.Views.AssociarAcompanhantePage"
    Title="Associar Acompanhante"
    BackgroundColor="#F5FAF8">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Label
                Text="Associar acompanhante"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#155263"
                HorizontalOptions="Center" />

            <Label
                Text="Selecione o acompanhante e o idoso que ele poderá acompanhar."
                FontSize="14"
                TextColor="#444444" />

            <Label
                Text="Acompanhante"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Picker
                x:Name="pckAcompanhante"
                Title="Selecione o acompanhante"
                ItemDisplayBinding="{Binding Nome}"
                BackgroundColor="White" />

            <Label
                Text="Idoso"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Picker
                x:Name="pckIdoso"
                Title="Selecione o idoso"
                ItemDisplayBinding="{Binding Nome}"
                BackgroundColor="White" />

            <Button
                Text="Associar"
                Clicked="BtnAssociar_Clicked"
                BackgroundColor="#155263"
                TextColor="White"
                CornerRadius="10" />

            <Button
                Text="Voltar"
                Clicked="BtnVoltar_Clicked"
                BackgroundColor="#DCE9E8"
                TextColor="#155263"
                CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
