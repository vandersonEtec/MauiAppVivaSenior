<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.EditarConsultaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Editar Consulta"
    BackgroundColor="#F5FAF8">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Editar Consulta"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Label
                Text="Especialidade"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Entry
                x:Name="txtEspecialidade"
                Placeholder="Ex.: Cardiologia" />

            <Label
                Text="Médico"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Entry
                x:Name="txtMedico"
                Placeholder="Nome do médico" />

            <Label
                Text="Data"
                FontAttributes="Bold"
                TextColor="#155263" />

            <DatePicker
                x:Name="dtpData" />

            <Label
                Text="Horário"
                FontAttributes="Bold"
                TextColor="#155263" />

            <TimePicker
                x:Name="tmpHorario" />

            <Label
                Text="Observação"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Editor
                x:Name="txtObservacao"
                Placeholder="Digite uma observação"
                AutoSize="TextChanges"
                HeightRequest="100" />

            <Button
                Text="Salvar"
                BackgroundColor="#10A77F"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="BtnSalvar_Clicked" />

            <Button
                Text="Cancelar"
                BackgroundColor="#777777"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="BtnCancelar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>