<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.ConsultasPage"
    x:Name="PaginaConsultas"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Consultas"
            FontFamily="OpenSansSemibold"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="#155263" />

        <Label
            Grid.Row="1"
            x:Name="lblNomeIdoso"
            FontFamily="OpenSansRegular"
            FontSize="15"
            TextColor="#666666" />

        <Button
            Grid.Row="2"
            x:Name="BtnCadastrarConsulta"
            Text="+ Cadastrar Consulta"
            FontFamily="OpenSansSemibold"
            FontSize="14"
            BackgroundColor="#155263"
            TextColor="White"
            CornerRadius="9"
            HeightRequest="46"
            IsVisible="{Binding ExibirCadastrar}"
            Clicked="BtnCadastrarConsulta_Clicked" />

        <CollectionView
            Grid.Row="3"
            x:Name="listaConsultas"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="📅"
                        FontSize="40"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Nenhuma consulta cadastrada"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        TextColor="#155263"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#DCE7E5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="13"
                        Margin="0,4">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="{Binding Especialidade}"
                                FontFamily="OpenSansSemibold"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#155263" />

                            <Label
                                Text="{Binding Medico, StringFormat='Médico: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Data, StringFormat='Data: {0:dd/MM/yyyy}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Horario, StringFormat='Horário: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Local, StringFormat='Local: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Observacao, StringFormat='Observação: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Documentos, StringFormat='Documentos: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <HorizontalStackLayout
                                Spacing="7"
                                Margin="0,4,0,0">

                                <Button
                                    Text="✏️ Editar"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    BackgroundColor="#155263"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding Source={x:Reference PaginaConsultas}, Path=ExibirEditar}"
                                    Clicked="BtnEditarConsulta_Clicked" />

                                <Button
                                    Text="🗑️ Excluir"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    BackgroundColor="#D9534F"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding Source={x:Reference PaginaConsultas}, Path=ExibirExcluir}"
                                    Clicked="BtnExcluirConsulta_Clicked" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>