<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.CatalogoMedicamentosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Catálogo de Medicamentos"
            FontFamily="OpenSansSemibold"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="#155263" />

        <Label
            Grid.Row="1"
            Text="Selecione uma medicação ou cadastre uma nova"
            FontFamily="OpenSansRegular"
            FontSize="14"
            TextColor="#666666" />

        <Button
            Grid.Row="2"
            Text="+ Cadastrar Medicação"
            FontFamily="OpenSansSemibold"
            FontSize="14"
            BackgroundColor="#155263"
            TextColor="White"
            CornerRadius="9"
            HeightRequest="46"
            Clicked="BtnCadastrarMedicamento_Clicked" />

        <CollectionView
            Grid.Row="3"
            x:Name="listaMedicamentos"
            SelectionMode="Single"
            SelectionChanged="MedicamentoSelecionado">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="8"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="💊"
                        FontSize="40"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Nenhuma medicação cadastrada"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        TextColor="#155263"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#DCE7E5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14"
                        Margin="0,4">

                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="{Binding Id, StringFormat='Código: {0}'}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                TextColor="#666666" />

                            <Label
                                Text="{Binding Nome}"
                                FontFamily="OpenSansSemibold"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#155263" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>