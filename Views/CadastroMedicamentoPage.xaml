<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.CadastroMedicamentoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="10">

            <Label
                Text="Cadastrar Medicação"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Label
                Text="Informe os dados da medicação"
                FontFamily="OpenSansRegular"
                FontSize="14"
                TextColor="#666666"
                Margin="0,0,0,5" />

            <Border
                BackgroundColor="White"
                Stroke="#DCE7E5"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="14">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Nome da medicação"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Entry
                        x:Name="txtNome"
                        Placeholder="Ex.: Dipirona"
                        PlaceholderColor="#888888"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42" />

                    <Label
                        Text="Via de administração"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Picker
                        x:Name="pckViaAdministracao"
                        Title="Selecione a via"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42">

                        <Picker.Items>
                            <x:String>Oral</x:String>
                            <x:String>Injetável</x:String>
                            <x:String>Tópica</x:String>
                            <x:String>Ocular</x:String>
                            <x:String>Nasal</x:String>
                            <x:String>Inalatória</x:String>
                            <x:String>Outra</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Status"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Picker
                        x:Name="pckStatus"
                        Title="Selecione o status"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42">

                        <Picker.Items>
                            <x:String>Ativo</x:String>
                            <x:String>Inativo</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Dosagem"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Entry
                        x:Name="txtDosagem"
                        Placeholder="Ex.: 01 comprimido"
                        PlaceholderColor="#888888"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42" />

                    <Label
                        Text="Horário da medicação"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <TimePicker
                        x:Name="tmpHorario"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263"
                        HeightRequest="42" />

                    <Label
                        Text="Observação"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Editor
                        x:Name="txtObservacao"
                        Placeholder="Ex.: Tomar após as refeições"
                        PlaceholderColor="#888888"
                        AutoSize="TextChanges"
                        HeightRequest="70"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        TextColor="#155263" />

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="8"
                        Margin="0,5,0,0">

                        <Button
                            Text="CANCELAR"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            BackgroundColor="#777777"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44"
                            Padding="15,0"
                            Clicked="BtnCancelar_Clicked" />

                        <Button
                            Text="SALVAR MEDICAÇÃO"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            BackgroundColor="#155263"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44"
                            Padding="15,0"
                            Clicked="BtnSalvar_Clicked" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>