<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.DetalhesIdosoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes do Idoso"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Detalhes do Idoso"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#155263" />

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Nome completo"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblNome"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#155263" />

                    <Label
                        Text="Idade"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblIdade"
                        FontSize="17"
                        TextColor="#333333" />

                    <Label
                        Text="Data de nascimento"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblDataNascimento"
                        FontSize="17"
                        TextColor="#333333" />

                    <Label
                        Text="CPF"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblCPF"
                        FontSize="17"
                        TextColor="#333333" />

                    <Label
                        Text="Telefone"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblTelefone"
                        FontSize="17"
                        TextColor="#333333" />

                    <Label
                        Text="Endereço"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblEndereco"
                        FontSize="17"
                        TextColor="#333333" />

                    <Label
                        Text="Observações"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />

                    <Label
                        x:Name="lblObservacoes"
                        FontSize="17"
                        TextColor="#333333" />

                </VerticalStackLayout>

            </Border>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    Text="💊 Medicações"
                    BackgroundColor="#10A77F"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="BtnMedicamentos_Clicked" />

                <Button
                    Text="✏️ Editar"
                    BackgroundColor="#10A77F"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="BtnEditar_Clicked" />

                <Button
                    Text="🗑️ Excluir"
                    BackgroundColor="#D9534F"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="BtnExcluir_Clicked" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>