<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.DetalhesIdosoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="7">

            <Label
                Text="Detalhes do Idoso"
                FontFamily="OpenSansSemibold"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#155263"
                Margin="0,0,0,4" />

            <Border
                BackgroundColor="White"
                Stroke="#DCE7E5"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="14">

                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Nome completo"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblNome"
                        FontFamily="OpenSansSemibold"
                        FontSize="18"
                        TextColor="#155263" />

                    <Label
                        Text="Idade"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblIdade"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="Data de nascimento"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblDataNascimento"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="CPF"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblCPF"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="Telefone"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblTelefone"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="Endereço"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblEndereco"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="Gênero"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblGenero"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="Contato de emergência"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblContatoEmergencia"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                    <Label
                        Text="Observações"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        TextColor="#155263" />

                    <Label
                        x:Name="lblObservacoes"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#555555" />

                </VerticalStackLayout>

            </Border>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="7"
                Margin="0,4,0,0">

                <Button
                    Text="💊 Medicações"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    BackgroundColor="#155263"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="42"
                    Padding="10,0"
                    Clicked="BtnMedicamentos_Clicked" />

                <Button
                    x:Name="BtnEditar"
                    Text="✏️ Editar"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    BackgroundColor="#155263"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="42"
                    Padding="10,0"
                    Clicked="BtnEditar_Clicked" />
              
                <Button
                  Text="📝 Observações Diárias"
                  FontFamily="OpenSansSemibold"
                  FontSize="14"
                  BackgroundColor="#155263"
                  TextColor="White"
                  CornerRadius="9"
                  HeightRequest="46"
                  Clicked="BtnObservacoes_Clicked" />
              
                <Button
                    x:Name="BtnExcluir"
                    Text="🗑️ Excluir"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    BackgroundColor="#D9534F"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="42"
                    Padding="10,0"
                    Clicked="BtnExcluir_Clicked" />
  

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>