<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppVivaSenior.Views.DashboardPage"
    BackgroundColor="#F5FAF8">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Image
                Source="logo.jpg"
                HeightRequest="150"
                WidthRequest="150"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="VivaSenior"
                FontFamily="OpenSansSemibold"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#155263" />

            <Label
                Text="Cuidado que aproxima."
                FontFamily="OpenSansRegular"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#155263"
                Margin="0,0,0,10" />

            <Label
                Text="Menu principal"
                FontFamily="OpenSansSemibold"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#155263"
                Margin="0,5,0,0" />

            <Button
                Text="👴  Idosos"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#155263"
                TextColor="White"
                Clicked="BtnIdosos_Clicked" />

            <Button
                Text="💊  Medicamentos"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#155263"
                TextColor="White"
                Clicked="BtnMedicamentos_Clicked" />

            <Button
                Text="📅  Consultas"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#155263"
                TextColor="White"
                Clicked="BtnConsultas_Clicked" />

            <Button
                Text="📝  Observações"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#155263"
                TextColor="White"
                Clicked="BtnObservacoes_Clicked" />

            <Button
                x:Name="btnAssociarAcompanhantes"
                Text="👥  Associar Acompanhantes"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="10"
                BackgroundColor="#DCE9E8"
                TextColor="#155263"
                IsVisible="False"
                Clicked="BtnAssociarAcompanhantes_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
