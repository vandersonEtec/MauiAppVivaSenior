<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppVivaSenior.Views.LoginPage"
    BackgroundColor="#F5FAF8">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="12"
            VerticalOptions="Center">

            <Image
                Source="logo.jpg"
                HeightRequest="200"
                WidthRequest="200"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="VivaSenior"
                FontFamily="OpenSansSemibold"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#155263" />

            <Label
                Text="Cuidado que aproxima."
                FontFamily="OpenSansRegular"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#155263"
                Margin="0,0,0,20" />

            <Border
                Stroke="#155263"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="10">

                <Entry
                    x:Name="txtEmail"
                    Placeholder="E-mail"
                    PlaceholderColor="#777777"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    FontFamily="OpenSansRegular"
                    FontSize="16"
                    TextColor="#155263" />

            </Border>

            <Border
                Stroke="#155263"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="10">

                <Entry
                    x:Name="txtSenha"
                    Placeholder="Senha"
                    PlaceholderColor="#777777"
                    IsPassword="True"
                    FontFamily="OpenSansRegular"
                    FontSize="16"
                    TextColor="#155263" />

            </Border>

            <HorizontalStackLayout
                Spacing="10">

                <CheckBox
                    Color="#155263" />

                <Label
                    Text="Lembrar-me"
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    TextColor="#155263"
                    VerticalOptions="Center" />

                <Label
                    Text="Esqueci minha senha"
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    TextColor="#155263"
                    HorizontalOptions="EndAndExpand"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Button
                Text="ENTRAR"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                HeightRequest="50"
                CornerRadius="10"
                BackgroundColor="#155263"
                TextColor="White"
                FontAttributes="Bold"
                Margin="0,10,0,0"
                Clicked="BtnEntrar_Clicked" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="5"
                Margin="0,10,0,0">

                <Label
                    Text="Não tem uma conta?"
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    TextColor="#666666" />

                <Label
                    Text="Cadastre-se"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    TextColor="#155263"
                    FontAttributes="Bold">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CadastreSe_Tapped" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>