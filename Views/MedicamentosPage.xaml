<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.MedicamentosPage"
    x:Name="PaginaMedicamentos"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5FAF8">

    <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Medicamentos"
            FontFamily="OpenSansSemibold"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="#155263" />

        <Label
            Grid.Row="1"
            x:Name="lblNomeIdoso"
            FontFamily="OpenSansRegular"
            FontSize="15"
            TextColor="#666666" />

        <Button
            Grid.Row="2"
            x:Name="BtnCadastrarMedicamento"
            Text="+ Cadastrar Medicamento"
            FontFamily="OpenSansSemibold"
            FontSize="14"
            BackgroundColor="#155263"
            TextColor="White"
            CornerRadius="10"
            HeightRequest="46"
            Clicked="BtnCadastrarMedicamento_Clicked" />

        <CollectionView
            Grid.Row="3"
            x:Name="listaMedicamentos"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="💊"
                        FontSize="40"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Nenhum medicamento cadastrado"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        TextColor="#155263"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#DCE7E5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="13"
                        Margin="0,4">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Nome}"
                                FontFamily="OpenSansSemibold"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#155263" />

                            <Label
                                Text="{Binding ViaAdministracao, StringFormat='Via: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Status, StringFormat='Status: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Dosagem, StringFormat='Dosagem: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Horario, StringFormat='Horário: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding Observacao, StringFormat='Observação: {0}'}"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                TextColor="#555555" />

                            <HorizontalStackLayout
                                Spacing="7"
                                Margin="0,4,0,0">

                                <Button
                                    Text="✏️ Editar"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    BackgroundColor="#155263"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding Source={x:Reference PaginaMedicamentos}, Path=ExibirEditar}"
                                    Clicked="BtnEditarMedicamento_Clicked" />

                                <Button
                                    Text="🗑️ Desvincular"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    BackgroundColor="#D9534F"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding Source={x:Reference PaginaMedicamentos}, Path=ExibirExcluir}"
                                    Clicked="BtnExcluirMedicamento_Clicked" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>