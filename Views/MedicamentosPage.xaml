<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiAppVivaSenior.Views.MedicamentosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Medicações"
    BackgroundColor="#F5FAF8">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Medicações"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#155263" />

        <Label
            Grid.Row="1"
            x:Name="lblNomeIdoso"
            FontSize="16"
            TextColor="Gray" />

        <Button
            Grid.Row="2"
            Text="+ Adicionar Medicação"
            BackgroundColor="#10A77F"
            TextColor="White"
            CornerRadius="12"
            HeightRequest="50"
            Clicked="BtnCadastrarMedicamento_Clicked" />

        <CollectionView
            Grid.Row="3"
            x:Name="listaMedicamentos"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="💊"
                        FontSize="45"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Nenhuma medicação vinculada"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#155263"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Adicione uma medicação para este idoso."
                        FontSize="14"
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        Padding="15"
                        Margin="0,5">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Nome}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#155263" />
                            <Label
                                Text="{Binding Dosagem, StringFormat='Dosagem: {0}'}"
                                FontSize="14"
                                TextColor="Gray" />

                            <Label
                                Text="{Binding Horario, StringFormat='Horário: {0}'}"
                                FontSize="14"
                                TextColor="Gray" />

                            <Label
                                Text="{Binding Observacao, StringFormat='Observação: {0}'}"
                                FontSize="14"
                                TextColor="Gray" />

                            <HorizontalStackLayout
                                    Spacing="10">

                                <Button
                                    Text="✏️ Editar"
                                    BackgroundColor="#10A77F"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    HorizontalOptions="FillAndExpand"
                                    Clicked="BtnEditarMedicamento_Clicked" />

                                <Button
                                    Text="Desvincular"
                                    BackgroundColor="#D9534F"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    HorizontalOptions="FillAndExpand"
                                    Clicked="BtnExcluirMedicamento_Clicked" />      
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>